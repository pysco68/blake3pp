# FreeBSD base-system Clang, C++23: the lane that exercises the POSIX AIO
# backend (src/io/aio_backend.hpp, completions on a kqueue).
#
#   cmake -S . -B build/freebsd-clang-cxx23 -G Ninja \
#         -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/freebsd-clang-cxx23/freebsd-clang-cxx23.cmake
#
# Hand-written (not generated by tools/gen-toolchains.py, which covers the
# Linux native-compiler matrix). The base system ships exactly one
# unversioned Clang as cc/c++ with its own libc++ and lld, so there is no
# version to pin, no -stdlib= to pass and no linker to choose: naming any
# of them would state the default and would be wrong the day a lane wants
# the ports compiler instead.

set(TC_C_COMPILER "cc")
set(TC_CXX_COMPILER "c++")
set(TC_CXX_STANDARD "23")
set(TC_DEFAULT_BUILD_TYPE "RelWithDebInfo")

include("${CMAKE_CURRENT_LIST_DIR}/../common.cmake")
