build/
.cache/
compile_commands.json
blake3pp-bin.zip
release/
/thirdparty/

# cmake-re writes these beside the toolchain when it resolves an environment
# image; they pin a registry digest for that run and are regenerated on demand.
cmake/toolchains/*/*.container.lock
# Built documentation site and its Python environment.
_site/
.venv-docs/

# The prepared FreeBSD guest image: an input to docker/freebsd-guest.Dockerfile,
# produced by tools/freebsd-guest.sh prepare and never committed (it is
# 300-plus MB, and the content hash that tags the image covers the
# recipe rather than its output).
docker/.artifacts/*
!docker/.artifacts/.gitkeep
