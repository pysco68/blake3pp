{
  "version": 6,
  "include": [
    "CMakePresets-toolchains.json"
  ],
  "configurePresets": [
    {
      "name": "linux-clang22-cxx26-beman",
      "displayName": "clang 22, C++26, beman.execution provider",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang22-cxx26-beman",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-clang22-cxx26.cmake",
      "cacheVariables": {
        "BLAKE3PP_EXECUTION_PROVIDER": "beman"
      }
    },
    {
      "name": "linux-arm64-gcc15-cxx23",
      "displayName": "aarch64 Linux cross (GCC 15, C++23, runs via qemu-user)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-arm64-gcc15-cxx23",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64-gcc15-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-riscv64-gcc15-cxx23",
      "displayName": "riscv64 Linux cross (GCC 15, C++23, runs via qemu-user)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-riscv64-gcc15-cxx23",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-riscv64-gcc15-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "wasm32-emcc-cxx23",
      "displayName": "WebAssembly (Emscripten, SIMD128 + threads, runs via node)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm32-emcc-cxx23",
      "toolchainFile": "${sourceDir}/cmake/toolchains/wasm32-emcc-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-arm64-zigmusl-cxx23-static",
      "displayName": "Static musl release (aarch64, zig + mimalloc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-arm64-zigmusl-cxx23-static",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64-zigmusl-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-riscv64-zigmusl-cxx23-static",
      "displayName": "Static musl release (riscv64, zig + mimalloc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-riscv64-zigmusl-cxx23-static",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-riscv64-zigmusl-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-zigmusl-cxx23-static",
      "displayName": "Static musl release (x86_64, zig + mimalloc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-zigmusl-cxx23-static",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-zigmusl-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-appleclang-cxx23",
      "displayName": "macOS Apple Clang, C++23 (GCD + F_NOCACHE I/O)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-appleclang-cxx23",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-clang22-cxx26",
      "displayName": "macOS Homebrew LLVM 22, C++26 (bundled libc++, GCD + F_NOCACHE I/O)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-clang22-cxx26",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-clang22-cxx26.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msvc2026-cxx23",
      "displayName": "Windows MSVC 2026, C++23 (run from a vcvars64 shell)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc2026-cxx23",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-msvc2026-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clangcl-cxx23",
      "displayName": "Windows clang-cl (VS LLVM toolset), C++23 (vcvars64 shell)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-clangcl-cxx23",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clangcl-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-msvc2026-cxx23",
      "displayName": "Windows arm64 cross (MSVC, scalar-only: xsimd lacks MSVC-arm64), vcvarsamd64_arm64 shell",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-arm64-msvc2026-cxx23",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-arm64-msvc2026-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-clangcl-cxx23",
      "displayName": "Windows arm64 cross (clang-cl, full NEON), vcvarsamd64_arm64 shell",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-arm64-clangcl-cxx23",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-arm64-clangcl-cxx23.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-clang22-cxx26-beman",
      "configurePreset": "linux-clang22-cxx26-beman"
    },
    {
      "name": "linux-arm64-gcc15-cxx23",
      "configurePreset": "linux-arm64-gcc15-cxx23"
    },
    {
      "name": "linux-riscv64-gcc15-cxx23",
      "configurePreset": "linux-riscv64-gcc15-cxx23"
    },
    {
      "name": "wasm32-emcc-cxx23",
      "configurePreset": "wasm32-emcc-cxx23"
    },
    {
      "name": "linux-arm64-zigmusl-cxx23-static",
      "configurePreset": "linux-arm64-zigmusl-cxx23-static"
    },
    {
      "name": "linux-riscv64-zigmusl-cxx23-static",
      "configurePreset": "linux-riscv64-zigmusl-cxx23-static"
    },
    {
      "name": "linux-zigmusl-cxx23-static",
      "configurePreset": "linux-zigmusl-cxx23-static"
    },
    {
      "name": "macos-appleclang-cxx23",
      "configurePreset": "macos-appleclang-cxx23",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-clang22-cxx26",
      "configurePreset": "macos-clang22-cxx26",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msvc2026-cxx23",
      "configurePreset": "windows-msvc2026-cxx23",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clangcl-cxx23",
      "configurePreset": "windows-clangcl-cxx23",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-msvc2026-cxx23",
      "configurePreset": "windows-arm64-msvc2026-cxx23",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-clangcl-cxx23",
      "configurePreset": "windows-arm64-clangcl-cxx23",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "testPresets": [
    {
      "name": "linux-clang22-cxx26-beman",
      "configurePreset": "linux-clang22-cxx26-beman",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-arm64-gcc15-cxx23",
      "configurePreset": "linux-arm64-gcc15-cxx23",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-riscv64-gcc15-cxx23",
      "configurePreset": "linux-riscv64-gcc15-cxx23",
      "output": {
        "outputOnFailure": true
